{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": ".verify",
    "rootDir": "src",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "incremental": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/lib/**/*.ts", "src/data/**/*.ts"],
  "exclude": ["node_modules"]
}
